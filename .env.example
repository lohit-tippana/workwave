# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# Leave empty to auto-start an in-memory MongoDB for local development/testing.
MONGO_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini (AI features). Leave empty to use the deterministic local fallback analyzer.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Razorpay (payments). Leave empty to run without payments (endpoints return 503).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (file storage). Leave empty to store uploads on local disk (backend/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script (optional overrides)
SEED_ADMIN_EMAIL=admin@workwave.dev
SEED_ADMIN_PASSWORD=Admin@12345
